# Copiá este archivo como ".env" y completá las claves:
#   cp .env.example .env
# El .env real NO se sube a GitHub (está en .gitignore).

# Conexión que usa PHP (login.php, socio.php, entrenador.php, admin.php)
DB_HOST=db
DB_NAME=fitpowerbd
DB_USER=root
DB_PASSWORD=cambiar_esta_clave

# Configuración del contenedor MySQL (docker-compose.yml)
# MYSQL_ROOT_PASSWORD tiene que ser igual a DB_PASSWORD si DB_USER=root
MYSQL_ROOT_PASSWORD=cambiar_esta_clave
MYSQL_DATABASE=fitpowerbd
MYSQL_USER=usuario
MYSQL_PASSWORD=cambiar_esta_clave
